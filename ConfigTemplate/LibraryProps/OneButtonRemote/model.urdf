<?xml version="1.0"?>
<robot name="One-button remote">
  <link name="remote">
    <visual name="housing">
      <origin xyz="0 0 0.009"/>
      <geometry><box size="0.14 0.055 0.018"/></geometry>
      <material name="charcoal"><color rgba="0.075 0.09 0.12 1"/></material>
    </visual>
    <visual name="button_bezel">
      <origin xyz="0.028 0 0.019"/>
