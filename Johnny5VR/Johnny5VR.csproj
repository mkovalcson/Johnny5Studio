<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>J5 Studio VR Player</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1701;CS8981</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);packaging/**;Releases/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/VR/StudioBuildIdentity.cs" Link="Bridge/StudioBuildIdentity.cs" />
    <Compile Include="../Shared/VR/SceneWire.cs" Link="Bridge/SceneWire.cs" />
    <Compile Include="../Shared/VR/DesktopWire.cs" Link="Bridge/DesktopWire.cs" />
    <Compile Include="../Shared/VR/EditorCommands.cs" Link="Bridge/EditorCommands.cs" />
    <Compile Include="../Shared/VR/PoseWire.cs" Link="Bridge/PoseWire.cs" />
    <Compile Include="../Shared/VR/CasterWheelTravel.cs" Link="Bridge/CasterWheelTravel.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <None Update="ThirdParty/OpenVR/openvr_api.dll" CopyToOutputDirectory="PreserveNewest" Link="openvr_api.dll" TargetPath="openvr_api.dll" />
    <None Update="ThirdParty/OpenVR/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/LaserRange/*.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="Audio/LaserRange/%(Filename)%(Extension)" />
    <None Update="Shaders/Scene.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Input/*.json;Input/*.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Controls/J5Studio.Controls.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Configuration/J5Studio.Configuration.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Animation/J5Studio.Animation.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Pose/J5Studio.Pose.csproj" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../ServoAnimator/ServoAnimator/Assets/ControlIcons/*.png" Exclude="../ServoAnimator/ServoAnimator/Assets/ControlIcons/control-icons-preview.png">
      <LogicalName>J5Studio.ControlIcons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="../Shared/StudioVersion.targets" />
</Project>
