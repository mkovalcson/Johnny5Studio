<Project>
  <Import Project="StudioBuild.targets" />
  <PropertyGroup>
    <_StudioVersionRecord>$(MSBuildThisFileDirectory)../ServoAnimator/Build/PROJECT_VERSION.json</_StudioVersionRecord>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <Target Name="ReadStudioVersion" BeforeTargets="GetAssemblyVersion"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsWpfTemporaryTargetAssembly)' != 'true' and '$(UseGeneratedEditorVersion)' != 'true'">
    <PropertyGroup>
      <_StudioVersionJson>$([System.IO.File]::ReadAllText('$(_StudioVersionRecord)'))</_StudioVersionJson>
      <Version>$([System.Text.RegularExpressions.Regex]::Match('$(_StudioVersionJson)', '&quot;version&quot;\s*:\s*&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;').Groups[1].Value)</Version>
      <EditorGenerationDate>$([System.Text.RegularExpressions.Regex]::Match('$(_StudioVersionJson)', '&quot;generatedDate&quot;\s*:\s*&quot;([0-9]{4}-[0-9]{2}-[0-9]{2})&quot;').Groups[1].Value)</EditorGenerationDate>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <Error Condition="'$(Version)' == '' or '$(EditorGenerationDate)' == ''" Text="Invalid Studio version record at $(_StudioVersionRecord)." />
    <Error Condition="'$(StudioReleaseVersion)' != '' and '$(StudioReleaseVersion)' != '$(Version)'" Text="Expected Studio version $(StudioReleaseVersion), but the Animation Editor's version record is $(Version)." />
    <ItemGroup>
      <AssemblyMetadata Include="GenerationDate" Value="$(EditorGenerationDate)" />
    </ItemGroup>
  </Target>
</Project>
