<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ServoAnimator
    =============
    A WPF (Windows-only) application that edits servo animation timelines
    against an audio waveform.

    Dependencies:
      * NAudio            - audio file decoding + playback (mp3/wav/etc.)
      * SkiaSharp.Views.WPF - hardware-friendly 2D canvas used to draw the
                              waveform, time axis, command markers and cursor.

    Build:  dotnet build       (requires the .NET 10 SDK on Windows)
    Run:    dotnet run
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnimationEditorPlayer</AssemblyName>
    <ApplicationIcon>Assets\AppIcon\animation-editor.ico</ApplicationIcon>
    <AssemblyTitle>J5 Studio VR Editor</AssemblyTitle>
    <Product>J5 Studio VR Editor</Product>
    <RootNamespace>ServoAnimator</RootNamespace>
    <!-- Explicit entry point (Program.cs). Normally WPF auto-generates
         Main from App.xaml, but if App.xaml's build action isn't
         "ApplicationDefinition" (e.g. after importing the files into an
         existing project) the build fails with "Program does not contain a
         static 'Main' method". StartupObject makes our explicit Main the
         entry point either way - and also disambiguates if BOTH Mains
         exist. -->
    <StartupObject>ServoAnimator.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/VR/SceneWire.cs" Link="Bridge/SceneWire.cs" />
    <Compile Include="../Shared/VR/DesktopWire.cs" Link="Bridge/DesktopWire.cs" />
    <Compile Include="../Shared/VR/EditorCommands.cs" Link="Bridge/EditorCommands.cs" />
    <Compile Include="../Shared/VR/PoseWire.cs" Link="Bridge/PoseWire.cs" />
    <Compile Include="../Shared/VR/CasterWheelTravel.cs" Link="Bridge/CasterWheelTravel.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon\animation-editor.ico" />
    <Resource Include="Shaders\UrdfTone.ps" />
    <Resource Include="Shaders\UrdfFxaa.ps" />
    <Resource Include="Assets\ControllerArtwork\*.png" />
    <Resource Include="Assets\ControlIcons\*.png"
              Exclude="Assets\ControlIcons\control-icons-preview.png" />
    <None Update="Models\johnny5_head.urdf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\servo_joint_map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\Meshes\**\*.obj" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\Meshes\**\*.stl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\Meshes\ExteriorOptimized\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Help\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Scripts\ConvertOneFileToJohnny5.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Native\SDL3\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Migration/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Controls/J5Studio.Controls.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Configuration/J5Studio.Configuration.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Animation/J5Studio.Animation.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Shared/Pose/J5Studio.Pose.csproj" /></ItemGroup>
<ItemGroup><Compile Include="../Shared/EditorChecks/PairedBodyEditorChecks.cs" Link="Checks/PairedBodyEditorChecks.cs" /></ItemGroup>
<ItemGroup><Compile Include="../Shared/EditorUI/*.cs" Link="SharedUI/%(Filename)%(Extension)" /></ItemGroup>
<ItemGroup><Compile Include="../Shared/EditorChecks/SequenceInsertionChecks.cs" Link="Checks/SequenceInsertionChecks.cs" /></ItemGroup>
  <ItemGroup>
    <None Include="../Shared/UserHelp/*.md" Link="Help/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../Documentation/VR-Rehearsal-Panel.md;../Documentation/VR-Follow-Input-Tuning.md;../Documentation/VR-Follow-Neutral-Pose.md;../Documentation/VR-Follow-Arm-Hand-Speeds.md;../Documentation/VR-Clean-Output.md;../Documentation/VR-Clean-Output-Overlays.md;../Documentation/VR-Controller-Feedback.md;../Documentation/URDF-Prop-Library.md;../Documentation/VR-Laser-Range-Game.md;../Documentation/VR-Laser-Range-Combat-And-Teleport.md" Link="Help/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../Shared/StudioVersion.targets" />
</Project>
